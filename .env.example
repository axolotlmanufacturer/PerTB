# perterabyte — environment template
#
# Copy to .env.local for development:   cp .env.example .env.local
# Nothing here is secret. .env / .env.local are gitignored; this file is not.
#
# The site is designed to run with NONE of the marketplace credentials filled
# in. `MOCK_DATA=true` is the default for local dev and CI, and the whole site
# — ingest, table, facets, landings — works against generated listings.


# ─── Database ────────────────────────────────────────────────────────────────

# Local dev: `pnpm db:up` starts the Postgres in docker-compose.yml and this
# URL matches it verbatim.
# Deploy: Neon (https://neon.tech) → project → Connection Details. Use the
# POOLED connection string; Prisma on serverless exhausts direct connections
# (known trap 3).
DATABASE_URL=postgresql://perterabyte:perterabyte@localhost:5432/perterabyte


# ─── Data source mode ────────────────────────────────────────────────────────

# true  → the mock adapter generates ~400 realistic listings. No credentials
#         needed. This is the default for dev and CI.
# false → live adapters, gated individually by the *_ENABLED flags below.
MOCK_DATA=true


# ─── Amazon — Creators API ───────────────────────────────────────────────────
#
# PA-API 5.0 is RETIRED and no longer accepts new registrations. Do not follow
# a PA-API tutorial; the SigV4 request-signing approach is dead. The
# replacement is the Creators API.
#
# ELIGIBILITY REALITY: the Creators API requires >=10 qualifying sales in the
# trailing 30 days, and access is revoked after any 30-day stretch without
# them. Amazon is an intermittently-available source. Keep this false until
# the account actually qualifies — the site is fully functional on eBay alone.

AMAZON_ENABLED=false

# Associates Central → Tools → Creators API → Create Application.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=

# Your Associates tracking id, e.g. yourtag-20. Appended to every product link.
AMAZON_PARTNER_TAG=

AMAZON_MARKETPLACE=www.amazon.com


# ─── eBay — Browse API + eBay Partner Network ────────────────────────────────
#
# Two separate accounts are involved:
#   • developer.ebay.com          → API client credentials (below)
#   • partnernetwork.ebay.com     → affiliate campaign id (below)
# The API keys alone earn nothing; attribution rides on the ePN campaign id.

EBAY_ENABLED=false

# developer.ebay.com → My Account → Application Keys → Production keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

EBAY_MARKETPLACE_ID=EBAY_US

# 10-digit campaign id from eBay Partner Network → Campaigns.
EPN_CAMPAIGN_ID=

# ePN rotation id. This is the standard US value; leave as-is unless ePN
# issues you a different one.
EPN_ROTATION_ID=711-53200-19255-0

# Seller quality floor. Used enterprise drives are where the lowest $/TB sits
# and also where the worst sellers are; these two numbers are the filter.
EBAY_MIN_FEEDBACK_PCT=98.5
EBAY_MIN_FEEDBACK_COUNT=50


# ─── Secrets ─────────────────────────────────────────────────────────────────

# Bearer token gating /api/cron/refresh (the manual ingest trigger).
# Generate: openssl rand -hex 32
CRON_SECRET=

# Shared secret the GitHub Actions ingest job uses to call the authenticated
# revalidation route. revalidateTag cannot be invoked from outside the
# deployment (known trap 11), so the job hits a route that calls it.
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# Password for /admin/quarantine, the sub-threshold listing review UI.
ADMIN_PASSWORD=


# ─── Site ────────────────────────────────────────────────────────────────────

# Absolute origin, no trailing slash. Used for metadataBase, sitemap and
# canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The brand is a placeholder and is parameterised so a rename is an env change.
NEXT_PUBLIC_SITE_NAME=perterabyte


# ─── Observability ───────────────────────────────────────────────────────────
# Both are wired but completely inert when unset: no script tag, no transport,
# no console noise. `pnpm build` behaves identically with and without them.

# Plausible → site settings. The bare domain, e.g. perterabyte.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Sentry → Project Settings → Client Keys (DSN). Server and edge runtimes.
SENTRY_DSN=

# Optional. Browser-side error reporting needs the DSN inlined into the client
# bundle, which requires the NEXT_PUBLIC_ prefix. Leave unset to report from
# the server only. (Addition to the brief's Appendix B — see README.)
NEXT_PUBLIC_SENTRY_DSN=
